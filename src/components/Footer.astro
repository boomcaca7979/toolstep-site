---
import { SITE_TITLE } from '../consts';

const today = new Date();

const exploreLinks = [
	{ label: 'Reviews', href: '/reviews/' },
	{ label: 'Best Tools', href: '/best/' },
	{ label: 'Compare', href: '/compare/' },
	{ label: 'Alternatives', href: '/alternatives/' },
	{ label: 'Categories', href: '/category/' },
	{ label: 'Stories', href: '/stories/' },
	{ label: 'All Tools', href: '/tools/' },
];

const editorialLinks = [
	{ label: 'About', href: '/about/' },
	{ label: 'Team', href: '/team/' },
	{ label: 'Authors', href: '/authors/' },
	{ label: 'How We Test', href: '/how-we-test/' },
	{ label: 'Editorial Policy', href: '/editorial-policy/' },
	{ label: 'Affiliate Disclosure', href: '/affiliate-disclosure/' },
	{ label: 'Blog', href: '/blog/' },
];

const legalLinks = [
	{ label: 'Contact', href: '/contact/' },
	{ label: 'Privacy', href: '/privacy/' },
	{ label: 'Terms', href: '/terms/' },
];
---

<footer class="site-footer">
	<div class="footer-inner footer-main">
		<div class="footer-brand">
			<a class="footer-logo" href="/" aria-label={`${SITE_TITLE} home`}>
				<span class="footer-mark" aria-hidden="true">
					<svg viewBox="0 0 32 32" fill="none">
						<rect width="32" height="32" rx="7" fill="var(--accent)"></rect>
						<path d="M8 10h16M16 10v13" stroke="#fff" stroke-width="3.2" stroke-linecap="round"></path>
					</svg>
				</span>
				<span class="footer-name">{SITE_TITLE}</span>
			</a>
			<p class="footer-tag">
				Independent reviews, comparisons, and practical guides for AI tools and software.
			</p>
		</div>

		<nav class="footer-col" aria-label="Explore">
			<h3>Explore</h3>
			{exploreLinks.map((l) => (
				<a href={l.href}>{l.label}</a>
			))}
		</nav>

		<nav class="footer-col" aria-label="Editorial">
			<h3>Editorial</h3>
			{editorialLinks.map((l) => (
				<a href={l.href}>{l.label}</a>
			))}
		</nav>

		<nav class="footer-col" aria-label="Legal">
			<h3>Legal</h3>
			{legalLinks.map((l) => (
				<a href={l.href}>{l.label}</a>
			))}
		</nav>
	</div>
	<div class="footer-bottom">
		<div class="footer-inner footer-bottom-inner">
			<span>&copy; {today.getFullYear()} {SITE_TITLE}. All rights reserved.</span>
			<span class="footer-note">We test every tool we review. Rankings are never sold.</span>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		background: var(--ink);
		color: var(--ink-text-muted);
	}
	.footer-inner {
		max-width: 1200px;
		margin: 0 auto;
		padding-left: 24px;
		padding-right: 24px;
	}
	.footer-main {
		display: grid;
		grid-template-columns: 4fr 2fr 2fr 2fr;
		gap: 40px;
		padding-top: 56px;
		padding-bottom: 48px;
	}
	.footer-brand {
		min-width: 0;
	}
	.footer-logo {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		text-decoration: none;
	}
	.footer-mark {
		display: inline-flex;
		width: 28px;
		height: 28px;
	}
	.footer-mark svg {
		width: 100%;
		height: 100%;
	}
	.footer-name {
		color: #ffffff;
		font-size: 18px;
		font-weight: 700;
		letter-spacing: -0.02em;
	}
	.footer-tag {
		font-size: 14px;
		line-height: 1.6;
		margin: 14px 0 0;
		max-width: 300px;
	}
	.footer-col {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	.footer-col h3 {
		font-size: 11px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: rgba(255, 255, 255, 0.45);
		margin: 0 0 6px;
	}
	.footer-col a {
		font-size: 14px;
		color: var(--ink-text-muted);
		text-decoration: none;
		transition: color 0.15s ease;
	}
	.footer-col a:hover {
		color: #ffffff;
	}
	.footer-bottom {
		border-top: 1px solid var(--ink-line);
	}
	.footer-bottom-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 8px 24px;
		padding-top: 20px;
		padding-bottom: 28px;
		font-size: 13px;
	}
	.footer-note {
		color: rgba(255, 255, 255, 0.45);
	}
	@media (max-width: 900px) {
		.footer-main {
			grid-template-columns: 1fr 1fr;
			gap: 32px;
		}
		.footer-brand {
			grid-column: 1 / -1;
		}
	}
	@media (max-width: 480px) {
		.footer-main {
			grid-template-columns: 1fr;
		}
		.footer-bottom-inner {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
