    <script>
      // Keep the horizontal-scroll affordances honest: the hint and the right-edge
      // fade are only shown while there is content still off-screen to the right.
      (function () {
        var frame = document.querySelector('.table-frame');
        if (!frame) return;
        var scroller = frame.querySelector('.table-wrap');
        if (!scroller) return;
        var hint = document.getElementById('table-scroll-hint');
        function update() {
          var overflow = scroller.scrollWidth - scroller.clientWidth;
          var scrollable = overflow > 4;
          var atEnd = !scrollable || scroller.scrollLeft >= overflow - 4;
          frame.classList.toggle('is-scrollable', scrollable);
          frame.classList.toggle('at-end', atEnd);
          if (hint) hint.hidden = !scrollable;
        }
        scroller.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update);
        update();
      })();
    </script>
