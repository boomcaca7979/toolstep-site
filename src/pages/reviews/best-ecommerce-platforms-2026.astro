const publishDate = '2026-07-30';
const author = 'ToolStep Editorial Team';

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Best Ecommerce Platforms 2026',
  description: 'Ranked list of the best ecommerce platforms in 2026: Shopify, WooCommerce, BigCommerce, and Squarespace.',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Shopify — Best Overall Ecommerce Platform', url: new URL('/reviews/best-ecommerce-platforms-2026/#best-overall-shopify', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: 'WooCommerce — Best for WordPress Flexibility', url: new URL('/reviews/best-ecommerce-platforms-2026/#best-wordpress-woocommerce', Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name: 'BigCommerce — Best for Growth & Enterprise', url: new URL('/reviews/best-ecommerce-platforms-2026/#best-growth-bigcommerce', Astro.site).toString() },
