    { '@type': 'ListItem', position: 1, name: 'Claude — Best Overall ChatGPT Alternative', url: new URL('/reviews/chatgpt-alternatives-2026/#best-overall-claude', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: 'Gemini — Best for Google Ecosystem & Multimodal', url: new URL('/reviews/chatgpt-alternatives-2026/#best-google-gemini', Astro.site).toString() },
