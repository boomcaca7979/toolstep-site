            <td>Coding, IDE integration</td>
            <td>$10/mo (Pro)</td>
            <td>Yes — limited</td>
            <td>4.5/5</td>
          </tr>
          <tr>
            <td>Perplexity</td>
            <td>Research, citations</td>
            <td>$20/mo (Pro)</td>
            <td>Yes — 5 Pro searches/day</td>
            <td>4.3/5</td>
          </tr>
