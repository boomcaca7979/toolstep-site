    { '@type': 'ListItem', position: 1, name: 'Adobe Express — Best Overall Canva Alternative', url: new URL('/reviews/canva-alternatives-2026/#best-overall-adobe-express', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: 'Figma — Best for UI/UX & Collaborative Design', url: new URL('/reviews/canva-alternatives-2026/#best-collab-figma', Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name: 'Visme — Best for Presentations & Infographics', url: new URL('/reviews/canva-alternatives-2026/#best-presentations-visme', Astro.site).toString() },
    { '@type': 'ListItem', position: 4, name: 'VistaCreate — Best for Social Media Marketing', url: new URL('/reviews/canva-alternatives-2026/#best-social-vistacreate', Astro.site).toString() },
    { '@type': 'ListItem', position: 5, name: 'Piktochart — Best for Infographics & Data Visualization', url: new URL('/reviews/canva-alternatives-2026/#best-infographics-piktochart', Astro.site).toString() },
