const pageTitle = 'Best Ecommerce Platform for Small Business 2026: Ranked & Compared';
const pageDescription = 'Best ecommerce platform for small business in 2026: Shopify, WooCommerce, BigCommerce, Squarespace, and Wix ranked for pricing, ease of use, SEO, and growth headroom.';
const publishDate = '2026-07-30';
const author = 'ToolStep Editorial Team';

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Best Ecommerce Platform for Small Business 2026',
  description: 'Ranked list of the best ecommerce platforms for small business in 2026.',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Shopify — Best Overall for Small Business', url: new URL('/reviews/best-ecommerce-platform-small-business-2026/#best-overall-shopify', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: 'WooCommerce — Best for Content-First Stores', url: new URL('/reviews/best-ecommerce-platform-small-business-2026/#best-content-woocommerce', Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name: 'BigCommerce — Best for Scaling Without Transaction Fees', url: new URL('/reviews/best-ecommerce-platform-small-business-2026/#best-scaling-bigcommerce', Astro.site).toString() },
    { '@type': 'ListItem', position: 4, name: 'Squarespace — Best for Design-First Brands', url: new URL('/reviews/best-ecommerce-platform-small-business-2026/#best-design-squarespace', Astro.site).toString() },
    { '@type': 'ListItem', position: 5, name: 'Wix — Best for Beginners on a Budget', url: new URL('/reviews/best-ecommerce-platform-small-business-2026/#best-beginners-wix', Astro.site).toString() },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={pageTitle}
      description={pageDescription}
      ogType="article"
      articleSchema={{headline: pageTitle, description: pageDescription, datePublished: publishDate, dateModified: publishDate, authorName: author}}
    />
    <link rel="canonical" href={new URL('/reviews/best-ecommerce-platform-small-business-2026/', Astro.site).toString()} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": new URL('/', Astro.site).toString() },
        { "@type": "ListItem", "position": 2, "name": "Reviews", "item": new URL('/reviews/', Astro.site).toString() },
        { "@type": "ListItem", "position": 3, "name": "Ecommerce", "item": new URL('/reviews/ecommerce/', Astro.site).toString() },
