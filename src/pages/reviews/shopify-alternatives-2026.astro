const publishDate = '2026-07-30';
const author = 'ToolStep Editorial Team';

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Best Shopify Alternatives 2026',
  description: 'Ranked list of the best Shopify alternatives in 2026 for merchants of every size: WooCommerce, BigCommerce, Squarespace Commerce, Wix Ecommerce, and Ecwid.',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'WooCommerce — Best Open-Source Shopify Alternative', url: new URL('/reviews/shopify-alternatives-2026/#best-opensource-woocommerce', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: 'BigCommerce — Best Hosted Enterprise Alternative', url: new URL('/reviews/shopify-alternatives-2026/#best-hosted-enterprise-bigcommerce', Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name: 'Squarespace Commerce — Best Content-First Alternative', url: new URL('/reviews/shopify-alternatives-2026/#best-content-squarespace', Astro.site).toString() },
    { '@type': 'ListItem', position: 4, name: 'Wix Ecommerce — Best for Beginners and Creators', url: new URL('/reviews/shopify-alternatives-2026/#best-beginners-wix', Astro.site).toString() },
    { '@type': 'ListItem', position: 5, name: 'Ecwid — Best Add-to-Existing-Site Alternative', url: new URL('/reviews/shopify-alternatives-2026/#best-addsite-ecwid', Astro.site).toString() },
  ],
};
