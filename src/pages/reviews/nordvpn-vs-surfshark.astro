        <tr><td>Countries</td><td>111</td><td>100</td></tr>
        <tr><td>Protocols</td><td>NordLynx, OpenVPN, IKEv2</td><td>WireGuard, OpenVPN, IKEv2</td></tr>
        <tr><td>No-Logs Audit</td><td>Yes, twice by PwC and Deloitte</td><td>Yes, by Deloitte</td></tr>
        <tr><td>Headquarters</td><td>Panama</td><td>Netherlands</td></tr>
