---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { categories, type Category } from '../../data/categories';
import { categoryMatches } from '../../data/category-map';
import { reviews } from '../../data/reviews';
import { compareData } from '../../data/compare';
import { bestData } from '../../data/best';

export function getStaticPaths() {
  return categories.map((cat) => ({
    params: { slug: cat.slug },
    props: { category: cat },
  }));
}

interface Props {
  category: Category;
}

const { category } = Astro.props;
const { slug, name, pluralName, description, color } = category;

const pageTitle = `${category.pluralName} Reviews, Comparisons & Buying Guides — ToolStep`;
const pageDescription = `${description} Compare the best ${pluralName.toLowerCase()} with our in-depth reviews, head-to-head comparisons, and ranked guides.`;
const canonicalURL = new URL(`/category/${slug}/`, Astro.site);

// Filter content by canonical slug using the compatibility map.
// No hardcoding — all matching goes through categoryMatches().
const relatedReviews = reviews
  .filter((r) => categoryMatches(r.category, slug, r.title))
  .slice(0, 8);

const topCompares = compareData
  .filter((c) => categoryMatches(c.category, slug, c.title))
  .slice(0, 6);

const featuredBests = bestData
  .filter((b) => categoryMatches(b.category, slug, b.title))
  .slice(0, 6);

const totalItems = relatedReviews.length + topCompares.length + featuredBests.length;
const isEmptyCategory = totalItems === 0;

// For empty categories, pull related content from sibling categories
// so the page still offers value instead of showing only empty states.
const fallbackReviews = isEmptyCategory
  ? reviews.slice(0, 4)
  : [];
const fallbackCompares = isEmptyCategory
  ? compareData.slice(0, 3)
  : [];
const fallbackBests = isEmptyCategory
  ? bestData.slice(0, 3)
  : [];

// Build FAQ — always at least 2 questions for SEO.
// For empty categories, add generic helpful questions.
// Phase 3: per-category editorial guidance (definition + selection criteria).
const categoryEditorial: Record<string, { definition: string; criteria: string[] }> = {
  "standing-desks": {
    definition: "Standing desks that raise your workstation electrically or manually. This category covers full desks — for desktop converters that sit on an existing desk, see the standing-desk converter guide.",
    criteria: [
      "Stability at full height (the most common failure)",
      "Dual-motor lift quality and noise",
      "Weight capacity for your monitor load",
      "Warranty length — a signal of frame confidence",
    ],
  },
  "office-chairs": {
    definition: "Office and ergonomic chairs for daily desk work. This category covers task and ergonomic seating; gaming-style racing chairs have their own guide.",
    criteria: [
      "Adjustable lumbar that fits your spine curve",
      "Seat depth and armrest adjustability",
      "Breathability for long sessions",
      "Warranty — premium chairs run 12 years",
    ],
  },
  "ergonomic-chairs": {
    definition: "Ergonomic chairs with the deeper adjustability tier: adjustable lumbar, armrests, and seat depth. A subset of office chairs filtered for real fit flexibility.",
    criteria: [
      "Granular lumbar positioning",
      "3D/4D armrests",
      "Seat depth range for your height",
      "Materials (mesh vs foam) for your climate",
    ],
  },
  "keyboards": {
    definition: "Keyboards for work and play — mechanical and membrane, wired and wireless. Choose by switch feel first: it decides every typing hour after.",
    criteria: [
      "Switch type and typing feel",
      "Hot-swappability for future changes",
      "Wireless reliability and multi-device",
      "Layout (TKL/75%/full) for your desk",
    ],
  },
  "mice": {
    definition: "Mice for productivity and gaming. Ergonomic shaping decides daily comfort; sensor quality decides precision.",
    criteria: [
      "Ergonomic shape for your grip",
      "Sensor accuracy for your work",
      "Multi-device support",
      "Battery life for wireless models",
    ],
  },
  "monitors": {
    definition: "Desktop monitors for work, creation, and gaming. Text clarity and panel quality matter for work; refresh rate matters for games — pick your priority.",
    criteria: [
      "Panel quality and text clarity",
      "Resolution for your viewing distance",
      "USB-C docking for laptops",
      "Ergonomic stand adjustability",
    ],
  },
  "webcams": {
    definition: "Webcams for calls, streaming, and recording. A webcam earns its money in low light and framing — resolution alone is not quality.",
    criteria: [
      "Low-light performance",
      "Autofocus and framing",
      "True sensor resolution vs upscaled",
      "Mic quality if you use it for calls",
    ],
  },
  "headphones": {
    definition: "Headphones for music, calls, and travel. ANC depth, sound tuning, and comfort are separate axes — flagships rarely lead all three.",
    criteria: [
      "ANC depth for your environment",
      "Sound signature (balanced vs warm)",
      "Comfort for long sessions",
      "Battery and codec support",
    ],
  },
  "docks": {
    definition: "USB-C and Thunderbolt docks that turn one cable into a full desk. Choose by port count and charging power — certified Thunderbolt 4 guarantees dual 4K60.",
    criteria: [
      "Port count vs your peripherals",
      "Charging wattage (96W+ for pro laptops)",
      "Display support (dual 4K60 baseline)",
      "Thermals and warranty",
    ],
  },
  "storage": {
    definition: "External SSDs and hard drives. SSDs win speed and durability; HDDs win price per terabyte — backup archives vs daily transfers.",
    criteria: [
      "Sustained speed (not peak marketing)",
      "Durability ratings for travel",
      "Price per terabyte",
      "Interface (USB 3.2 vs Thunderbolt)",
    ],
  },
  "desk-accessories": {
    definition: "The supporting cast of a desk: lamps, stands, pads, and cable management. Individually small, collectively they decide desk comfort.",
    criteria: [
      "Material quality for daily handling",
      "Actual footprint on your desk",
      "Solve a real problem (glare, clutter, posture)",
      "Price vs build longevity",
    ],
  },
  "ai-assistants": {
    definition: "General-purpose AI chatbots and assistants. Capabilities change monthly — pick on ecosystem fit and data policy as much as raw model quality.",
    criteria: [
      "Reasoning and writing quality for your tasks",
      "Context window for your documents",
      "Ecosystem integrations",
      "Data and privacy policy",
    ],
  },
  "ai-writing": {
    definition: "AI writing and grammar tools for professional text. Real-time assistance and long-form analysis are different strengths.",
    criteria: [
      "Correction accuracy (fewer false positives)",
      "Integration coverage (browser, Office, Docs)",
      "Style feedback depth",
      "Cost per month at your volume",
    ],
  },
  "ai-coding": {
    definition: "AI coding assistants for completion, refactoring, and agent workflows. Editor compatibility is often the binding constraint.",
    criteria: [
      "IDE compatibility",
      "Multi-file/agentic capability",
      "Codebase awareness",
      "Price per seat at team scale",
    ],
  },
  "ai-image": {
    definition: "AI image generators for creative and commercial output. Aesthetic ceiling and prompt control are separate strengths.",
    criteria: [
      "Output quality for your style",
      "Prompt control and editing",
      "Commercial use rights",
      "API/automation access",
    ],
  },
  "ai-video": {
    definition: "AI video generation and editing tools — an early, fast-moving category. Match output length and quality to your actual use.",
    criteria: [
      "Output quality and length limits",
      "Workflow integration",
      "Commercial use terms",
      "Cost per generated video",
    ],
  },
  "productivity": {
    definition: "Apps that organize your work: tasks, notes, and workspaces. Adoption is the real test — a tool you abandon helps nothing.",
    criteria: [
      "Capture speed",
      "Cross-platform sync reliability",
      "Consolidation vs specialization fit",
      "Long-term subscription cost",
    ],
  },
  "note-taking": {
    definition: "Note apps for capture and knowledge management. The core split: local-first files you own versus cloud workspaces with collaboration.",
    criteria: [
      "Organization and search model",
      "Sync reliability",
      "File format portability",
      "Price for your vault size",
    ],
  },
  "task-management": {
    definition: "Task managers for personal and shared to-dos. Capture speed and dependable reminders decide whether the system survives.",
    criteria: [
      "Capture speed (natural language)",
      "Recurring tasks and reminders",
      "Cross-platform sync",
      "Integrations with your stack",
    ],
  },
  "project-management": {
    definition: "Project management platforms for teams. Views, reporting, and adoption decide success — power without adoption fails.",
    criteria: [
      "Views (list/board/timeline) fit",
      "Reporting depth",
      "Adoption friction for your team",
      "Per-seat cost at scale",
    ],
  },
  "design-tools": {
    definition: "Design tools for UI/UX, prototyping, and collaboration. Match the tool to the deliverable: product UI vs marketing graphics are different jobs.",
    criteria: [
      "Collaboration model",
      "Prototyping depth",
      "Component/design-system support",
      "Handoff to developers",
    ],
  },
  "security": {
    definition: "VPNs, password managers, and privacy tools. Trust is the product: audits, no-logs policies, and breach history outweigh features.",
    criteria: [
      "Independent audits and no-logs policy",
      "Jurisdiction and data policy",
      "Cross-platform coverage",
      "Multi-year total cost",
    ],
  },
  "cloud-storage": {
    definition: "Cloud storage for sync, sharing, and backup-adjacent use. Ecosystem fit and privacy posture are as important as free capacity.",
    criteria: [
      "Free capacity and per-TB price",
      "Sync reliability",
      "Ecosystem integration",
      "Privacy and encryption posture",
    ],
  },
  "video-tools": {
    definition: "Screen recorders and video editors for content creation. Recording and editing are separate jobs — some tools do one well.",
    criteria: [
      "Capture quality (resolution/fps)",
      "Editing workflow depth",
      "Export formats and quality",
      "Cost model (free/subscription/buy-once)",
    ],
  },
};

const catGuide = categoryEditorial[slug];
const faqs = [
  {
    question: `What are the best ${pluralName.toLowerCase()} in 2026?`,
    answer: catGuide
      ? `${catGuide.definition} The main selection criteria: ${catGuide.criteria.map((c, i) => `(${i + 1}) ${c.charAt(0).toLowerCase()}${c.slice(1)}`).join('; ')}.`
      : description,
  },
  ...(featuredBests[0]?.faqs.slice(0, 2).map((f) => ({
    question: f.question,
    answer: f.answer,
  })) || []),
  ...(isEmptyCategory ? [
    {
      question: `How do I choose the right ${name.toLowerCase()}?`,
      answer: `When choosing a ${name.toLowerCase()}, consider your budget, intended use case, and must-have features. Our team researches and compares the top options to help you make an informed decision — check back soon for dedicated ${pluralName.toLowerCase()} guides.`,
    },
    {
      question: `Does ToolStep review ${pluralName.toLowerCase()}?`,
      answer: `Yes. ToolStep is actively expanding its ${pluralName.toLowerCase()} coverage. In the meantime, browse our other categories or check the latest reviews for related product recommendations.`,
    },
  ] : []),
];

// Schemas
const collectionPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: pageTitle,
  description: pageDescription,
  url: canonicalURL.toString(),
  isPartOf: { '@type': 'WebSite', name: 'ToolStep', url: 'https://www.toolstep.top' },
  numberOfItems: totalItems,
  ...(totalItems > 0 ? {
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: [
        ...featuredBests.slice(0, 6).map((b, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: b.title,
          url: new URL(`/best/${b.slug}/`, Astro.site).toString(),
        })),
        ...topCompares.slice(0, 6).map((c, i) => ({
          '@type': 'ListItem',
          position: i + 1 + featuredBests.length,
          name: c.title,
          url: new URL(`/compare/${c.slug}/`, Astro.site).toString(),
        })),
        ...relatedReviews.slice(0, 8).map((r, i) => ({
          '@type': 'ListItem',
          position: i + 1 + featuredBests.length + topCompares.length,
          name: r.title,
          url: new URL(r.href, Astro.site).toString(),
        })),
      ],
    },
  } : {}),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.toolstep.top/' },
    { '@type': 'ListItem', position: 2, name: 'Categories', item: 'https://www.toolstep.top/#categories' },
    { '@type': 'ListItem', position: 3, name: pluralName, item: canonicalURL.toString() },
  ],
};

const faqSchema = faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
} : null;

// Sibling categories for navigation
const siblingCategories = categories.filter((c) => c.slug !== slug).slice(0, 10);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<script type="application/ld+json" set:html={JSON.stringify(collectionPageSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
		{faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
		<style>
			.page-hero {
				max-width: 1200px;
				margin: 0 auto;
				padding: 48px 24px 24px;
			}
			.breadcrumb {
				font-size: 13px;
				color: rgb(var(--gray));
				margin-bottom: 12px;
			}
			.breadcrumb a {
				color: rgb(var(--gray));
				text-decoration: none;
			}
			.breadcrumb a:hover {
				color: var(--accent);
			}
			.page-hero h1 {
				font-size: 36px;
				font-weight: 800;
				margin: 0 0 12px 0;
				color: rgb(var(--gray-dark));
				letter-spacing: -0.02em;
			}
			.page-hero p {
				font-size: 17px;
				color: rgb(var(--gray));
				margin: 0;
				line-height: 1.6;
				max-width: 720px;
			}
			.page-hero .count-badge {
				display: inline-block;
				margin-top: 16px;
				padding: 6px 14px;
				border-radius: 20px;
				background: rgba(var(--accent-rgb), 0.1);
				color: var(--accent);
				font-size: 13px;
				font-weight: 600;
			}

			.section-block {
				max-width: 1200px;
				margin: 0 auto;
				padding: 28px 24px;
			}
			.section-head {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				margin-bottom: 18px;
				gap: 12px;
				flex-wrap: wrap;
			}
			.section-head h2 {
				margin: 0;
				font-size: 24px;
				font-weight: 700;
				color: rgb(var(--gray-dark));
			}
			.view-all-link {
				font-size: 14px;
				font-weight: 600;
				color: var(--accent);
				text-decoration: none;
				white-space: nowrap;
			}
			.view-all-link:hover {
				text-decoration: underline;
			}

			.cards-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
				gap: 16px;
			}
			.content-card {
				display: flex;
				flex-direction: column;
				gap: 8px;
				padding: 18px;
				border-radius: 12px;
				border: 1px solid var(--card-border);
				background: var(--card-bg);
				text-decoration: none;
				transition: all 0.2s ease;
				box-shadow: var(--card-shadow);
			}
			.content-card:hover {
				border-color: var(--accent);
				transform: translateY(-2px);
				box-shadow: var(--card-shadow-hover);
			}
			.card-tag {
				display: inline-block;
				align-self: flex-start;
				font-size: 11px;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.04em;
				padding: 3px 8px;
				border-radius: 6px;
				color: white;
			}
			.card-title {
				font-size: 16px;
				font-weight: 700;
				color: rgb(var(--gray-dark));
				margin: 0;
				line-height: 1.3;
			}
			.card-desc {
				font-size: 13px;
				color: rgb(var(--gray));
				line-height: 1.5;
				margin: 0;
			}

			.empty-section {
				padding: 40px 20px;
				text-align: center;
				color: rgb(var(--gray));
				font-size: 14px;
				border: 1px dashed var(--card-border);
				border-radius: 12px;
			}

			.faq-block {
				max-width: 800px;
				margin: 0 auto;
				padding: 28px 24px;
			}
			.faq-block h2 {
				font-size: 24px;
				font-weight: 700;
				color: rgb(var(--gray-dark));
				margin: 0 0 18px 0;
			}
			.faq-item {
				border-bottom: 1px solid var(--card-border);
				padding: 16px 0;
			}
			.faq-item h3 {
				font-size: 16px;
				font-weight: 600;
				color: rgb(var(--gray-dark));
				margin: 0 0 8px 0;
			}
			.faq-item p {
				font-size: 14px;
				color: rgb(var(--gray));
				line-height: 1.6;
				margin: 0;
			}

			.sibling-cats {
				max-width: 1200px;
				margin: 0 auto;
				padding: 20px 24px 40px;
			}
			.sibling-cats h3 {
				font-size: 14px;
				font-weight: 600;
				color: rgb(var(--gray));
				text-transform: uppercase;
				letter-spacing: 0.05em;
				margin: 0 0 12px 0;
			}
			.sibling-list {
				display: flex;
				flex-wrap: wrap;
				gap: 8px;
			}
			.sibling-list a {
				padding: 8px 14px;
				border-radius: 8px;
				border: 1px solid var(--card-border);
				background: var(--card-bg);
				color: rgb(var(--gray-dark));
				font-size: 13px;
				font-weight: 500;
				text-decoration: none;
				transition: border-color 0.2s ease;
			}
			.sibling-list a:hover {
				border-color: var(--accent);
				color: var(--accent);
			}

			@media (max-width: 768px) {
				.page-hero {
					padding: 32px 16px 20px;
				}
				.page-hero h1 {
					font-size: 28px;
				}
				.section-block {
					padding: 20px 16px;
				}
				.cards-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />

		<section class="page-hero">
			<nav class="breadcrumb" aria-label="Breadcrumb">
				<a href="/">Home</a> › <a href="/#categories">Categories</a> › {pluralName}
			</nav>
			<h1>{pluralName} Reviews & Buying Guides</h1>
			<p>{description}</p>
			<span class="count-badge">{totalItems} resources · {featuredBests.length} guides · {topCompares.length} comparisons · {relatedReviews.length} reviews</span>
			{isEmptyCategory && (
				<p style="margin-top: 12px; font-size: 14px; color: rgb(var(--gray));">
					We're building out {pluralName.toLowerCase()} coverage. In the meantime, here are popular picks from other categories.
				</p>
			)}
		</section>

		{catGuide && (
			<section class="page-hero" style="padding-top: 0;">
				<h2 style="font-size: 24px; font-weight: 800; margin: 0 0 10px;">How to Choose {pluralName}</h2>
				<p style="max-width: 760px; color: rgb(var(--gray-dark)); line-height: 1.7;">{catGuide.definition}</p>
				<ul style="max-width: 760px; margin: 12px 0 0; padding-left: 20px; color: rgb(var(--gray-dark)); line-height: 1.8;">
					{catGuide.criteria.map((c) => <li>{c}</li>)}
				</ul>
			</section>
		)}

		{/* ===== Featured Best Guides ===== */}
		<section class="section-block">
			<div class="section-head">
				<h2>Best {pluralName} Guides</h2>
				<a class="view-all-link" href="/best/">All best guides →</a>
			</div>
			{featuredBests.length > 0 ? (
				<div class="cards-grid">
					{featuredBests.map((b) => (
						<a class="content-card" href={`/best/${b.slug}/`}>
							<span class="card-tag" style={`background: ${b.color}`}>{b.category}</span>
							<h3 class="card-title">{b.title}</h3>
							<p class="card-desc">{b.description}</p>
						</a>
					))}
				</div>
			) : isEmptyCategory && fallbackBests.length > 0 ? (
				<div class="cards-grid">
					{fallbackBests.map((b) => (
						<a class="content-card" href={`/best/${b.slug}/`}>
							<span class="card-tag" style={`background: ${b.color}`}>{b.category}</span>
							<h3 class="card-title">{b.title}</h3>
							<p class="card-desc">{b.description}</p>
						</a>
					))}
				</div>
			) : (
				<div class="empty-section">No best guides for this category yet. <a href="/best/">Browse all guides →</a></div>
			)}
		</section>

		{/* ===== Top Comparisons ===== */}
		<section class="section-block">
			<div class="section-head">
				<h2>Top {pluralName} Comparisons</h2>
				<a class="view-all-link" href="/compare/">All comparisons →</a>
			</div>
			{topCompares.length > 0 ? (
				<div class="cards-grid">
					{topCompares.map((c) => (
						<a class="content-card" href={`/compare/${c.slug}/`}>
							<span class="card-tag" style={`background: ${c.color}`}>{c.category}</span>
							<h3 class="card-title">{c.title}</h3>
							<p class="card-desc">{c.description}</p>
						</a>
					))}
				</div>
			) : isEmptyCategory && fallbackCompares.length > 0 ? (
				<div class="cards-grid">
					{fallbackCompares.map((c) => (
						<a class="content-card" href={`/compare/${c.slug}/`}>
							<span class="card-tag" style={`background: ${c.color}`}>{c.category}</span>
							<h3 class="card-title">{c.title}</h3>
							<p class="card-desc">{c.description}</p>
						</a>
					))}
				</div>
			) : (
				<div class="empty-section">No comparisons for this category yet. <a href="/compare/">Browse all comparisons →</a></div>
			)}
		</section>

		{/* ===== Related Reviews ===== */}
		<section class="section-block">
			<div class="section-head">
				<h2>{pluralName} Reviews</h2>
				<a class="view-all-link" href="/reviews/">All reviews →</a>
			</div>
			{relatedReviews.length > 0 ? (
				<div class="cards-grid">
					{relatedReviews.map((r) => (
						<a class="content-card" href={r.href}>
							<span class="card-tag" style={`background: ${r.color}`}>{r.category}</span>
							<h3 class="card-title">{r.title}</h3>
							<p class="card-desc">{r.desc}</p>
						</a>
					))}
				</div>
			) : isEmptyCategory && fallbackReviews.length > 0 ? (
				<div class="cards-grid">
					{fallbackReviews.map((r) => (
						<a class="content-card" href={r.href}>
							<span class="card-tag" style={`background: ${r.color}`}>{r.category}</span>
							<h3 class="card-title">{r.title}</h3>
							<p class="card-desc">{r.desc}</p>
						</a>
					))}
				</div>
			) : (
				<div class="empty-section">No reviews for this category yet. <a href="/reviews/">Browse all reviews →</a></div>
			)}
		</section>

		{/* ===== FAQ ===== */}
		{faqs.length > 0 && (
			<section class="faq-block">
				<h2>Frequently Asked Questions</h2>
				{faqs.map((f) => (
					<div class="faq-item">
						<h3>{f.question}</h3>
						<p>{f.answer}</p>
					</div>
				))}
			</section>
		)}

		{/* ===== Related Categories ===== */}
		<section class="sibling-cats">
			<h3>Related Categories</h3>
			<div class="sibling-list">
				{siblingCategories.map((c) => (
					<a href={`/category/${c.slug}/`} title={`Browse ${c.pluralName.toLowerCase()} guides, reviews, and comparisons`}>{c.pluralName}</a>
				))}
			</div>
			<div class="all-categories-link" style="margin-top: 14px;">
				<a href="/category/" style="font-size: 13px; color: var(--accent); font-weight: 600; text-decoration: none;">View all categories →</a>
			</div>
		</section>

		{/* ===== Quick Browse ===== */}
		<section class="section-block" style="padding-top: 0;">
			<div style="background: rgba(var(--accent-rgb), 0.03); border: 1px solid rgba(var(--accent-rgb), 0.12); border-radius: 12px; padding: 20px 24px; text-align: center;">
				<h3 style="margin: 0 0 8px 0; font-size: 16px; font-weight: 700; color: rgb(var(--gray-dark));">Browse More on ToolStep</h3>
				<p style="margin: 0 0 12px 0; font-size: 13px; color: rgb(var(--gray));">Explore our complete directory of reviews, comparisons, and best-of guides.</p>
				<div style="display: flex; justify-content: center; gap: 16px; flex-wrap: wrap;">
					<a href="/reviews/" style="font-size: 13px; color: var(--accent); font-weight: 600; text-decoration: none;">All Reviews →</a>
					<a href="/compare/" style="font-size: 13px; color: var(--accent); font-weight: 600; text-decoration: none;">All Comparisons →</a>
					<a href="/best/" style="font-size: 13px; color: var(--accent); font-weight: 600; text-decoration: none;">All Best Guides →</a>
					<a href="/tools/" style="font-size: 13px; color: var(--accent); font-weight: 600; text-decoration: none;">Tools Directory →</a>
				</div>
			</div>
		</section>

		<Footer />
	</body>
</html>
