<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
		<style>
			.guides-wrap {
				box-sizing: border-box;
				width: 100%;
				max-width: 768px;
				margin: 0 auto;
				padding: 48px 24px 64px;
				min-height: calc(100vh - 200px);
			}
			.breadcrumb {
				display: flex;
				align-items: center;
				flex-wrap: wrap;
				gap: 0.3rem;
				font-size: 0.82rem;
				color: rgb(var(--gray));
				margin-bottom: 1.5rem;
			}
			.breadcrumb a {
				color: rgb(var(--gray));
				text-decoration: none;
				transition: color 0.15s ease;
			}
			.breadcrumb a:hover {
				color: var(--accent);
			}
			.breadcrumb .separator {
				color: rgb(var(--gray-light));
			}
			.breadcrumb .current {
				color: rgb(var(--gray-dark));
				font-weight: 600;
			}
			.guides-hero {
				margin-bottom: 2.5rem;
				padding-bottom: 1.5rem;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.guides-hero h1 {
				font-size: 2.2rem;
				margin: 0 0 0.75rem;
				line-height: 1.2;
			}
			.guides-hero p {
				font-size: 1.05rem;
				color: rgb(var(--gray));
				line-height: 1.7;
				margin: 0;
			}
			.guide-count {
				display: block;
				margin-top: 1rem;
				font-size: 0.78rem;
				font-weight: 600;
				letter-spacing: 0.04em;
				text-transform: uppercase;
				color: rgb(var(--gray));
			}
			.guide-list {
				display: flex;
				flex-direction: column;
				gap: 1.25rem;
			}
			.guide-card {
				display: block;
				padding: 1.5rem;
				background: var(--card-bg);
				border: 1px solid var(--card-border);
				border-radius: 12px;
				box-shadow: var(--card-shadow);
				text-decoration: none;
				transition: transform 0.15s ease, box-shadow 0.15s ease;
			}
			.guide-card:hover {
				transform: translateY(-2px);
			}
			.guide-topic {
				display: inline-block;
				font-size: 0.72rem;
				font-weight: 700;
				letter-spacing: 0.06em;
				text-transform: uppercase;
				color: var(--accent);
				margin-bottom: 0.6rem;
			}
			.guide-card h2 {
				font-size: 1.25rem;
				margin: 0 0 0.5rem;
				color: rgb(var(--gray-dark));
				line-height: 1.35;
			}
			.guide-card p {
				font-size: 0.95rem;
				line-height: 1.65;
				color: rgb(var(--gray));
				margin: 0 0 0.75rem;
			}
			.guide-card .guide-date {
				font-size: 0.8rem;
				color: rgb(var(--gray));
				text-transform: uppercase;
				letter-spacing: 0.04em;
				font-weight: 600;
			}
			.guides-note {
				margin-top: 2.5rem;
				padding-top: 1.5rem;
				border-top: 1px solid rgb(var(--gray-light));
				font-size: 0.9rem;
				line-height: 1.7;
				color: rgb(var(--gray));
			}
			.guides-note a {
				color: var(--accent);
			}
			@media (max-width: 720px) {
				.guides-wrap {
					padding: 32px 16px 48px;
				}
				.guides-hero h1 {
					font-size: 1.8rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="guides-wrap">
			<nav class="breadcrumb" aria-label="Breadcrumb">
				<a href="/">Home</a>
				<span class="separator">/</span>
				<span class="current">Guides</span>
			</nav>

			<div class="guides-hero">
				<h1>Tool Guides &amp; Tutorials</h1>
				<p>
					Step-by-step explainers from the ToolStep editorial team. Each guide documents how a
					tool, model, or standard actually works — covering the setup path, the settings and
					specifications that matter, and the limitations worth knowing before you commit.
					Everything is researched from official documentation and published specifications
					rather than marketing copy.
				</p>
				<span class="guide-count">
					{guides.length} {guides.length === 1 ? 'guide' : 'guides'} published
				</span>
			</div>

			<div class="guide-list">
				{guides.map((guide) => (
					<a class="guide-card" href={guide.href}>
						<span class="guide-topic">{guide.topic}</span>
						<h2>{guide.title}</h2>
						<p>{guide.summary}</p>
						<span class="guide-date">{guide.date}</span>
					</a>
				))}
			</div>

			<p class="guides-note">
				ToolStep guides follow the same research standards as our reviews — see
				<a href="/how-we-test/">how we evaluate products</a> and our
				<a href="/editorial-policy/">editorial policy</a>.
			</p>
		</main>
		<Footer />
	</body>
</html>
