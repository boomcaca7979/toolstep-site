---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

const pageTitle = `Tool Guides & Tutorials — ${SITE_TITLE}`;
const pageDescription =
	'Step-by-step ToolStep guides and tutorials — how AI models, software, and standards actually work, documented from official specifications rather than marketing copy.';

// Only guides that are actually published and live on the site belong here.
// Every entry mirrors the target page's own title, summary and publication date.
const guides = [
	{
		title: 'Passkeys Explained: How They Work, What They Protect, and How Not to Get Locked Out',
		href: '/guides/passkeys-explained/',
		topic: 'Security & accounts',
		summary:
			'What a passkey is in credential terms, how WebAuthn challenge-response sign-in works, the difference between synced and device-bound passkeys, and the recovery planning that decides whether you are safer or locked out.',
		date: 'October 2026',
		dateISO: '2026-10-19',
	},
	{
		title: 'How to Verify a Download Before You Install It: Checksums and Signatures',
		href: '/guides/how-to-verify-a-download/',
		topic: 'Security & accounts',
		summary:
			'Working checksum commands for Windows, macOS and Linux, how to check a publisher signature, and why a matching hash proves integrity rather than safety.',
		date: 'October 2026',
		dateISO: '2026-10-19',
	},
	{
		title: 'The 3-2-1 Backup Rule, Applied to a Real Home-Office Computer',
		href: '/guides/3-2-1-backup-rule/',
		topic: 'Storage & backup',
		summary:
			'A concrete three-copy, two-media, one-off-site plan for one machine — why sync is not backup, how to automate it, and how to run a restore drill that actually proves the data is recoverable.',
		date: 'October 2026',
		dateISO: '2026-10-19',
	},
	{
		title: 'How to Move Your Password Vault to a New Manager Without Losing Accounts',
		href: '/guides/password-manager-migration/',
		topic: 'Security & accounts',
		summary:
			'The order that keeps a vault migration reversible: export, verify, import, reconcile item by item, re-enrol second factors, cut over device by device, then destroy the plaintext file.',
		date: 'October 2026',
		dateISO: '2026-10-19',
	},
	{
		title: 'Why Your Microphone Sounds Too Quiet: Gain, Input Levels, and OS Limits',
		href: '/guides/microphone-level-setup/',
		topic: 'Audio & conferencing',
		summary:
			'A four-stage signal-chain check for a quiet microphone — physical path, operating system gain, app processing, then distance and polar pattern — with what gain, input level and clipping actually mean.',
		date: 'October 2026',
		dateISO: '2026-10-19',
	},
	{
		title: 'Fix Your Webcam Image: Exposure, White Balance, Framing, and Light',
		href: '/guides/webcam-image-setup/',
		topic: 'Audio & conferencing',
		summary:
			'Six layers in the order that converges — light, exposure, white balance, framing, frame rate, app processing — and a local-clip test that tells you whether the room, the camera or the meeting app is at fault.',
		date: 'October 2026',
		dateISO: '2026-10-19',
	},
	{
		title: 'How to Check Whether a Drive Is Failing — and What to Do in the Hours You Have Left',
		href: '/guides/how-to-check-drive-health/',
		topic: 'Storage & backup',
		summary:
			'What SMART counters and SSD wear data really report, the failure signals they miss, and an order of operations that protects the data before any diagnostic workload touches the disk.',
		date: 'October 2026',
		dateISO: '2026-10-19',
	},
	{
		title: 'Block Ads and Trackers at the Network Level: Pi-hole vs AdGuard Home, Set Up and Verified',
		href: '/guides/dns-level-ad-blocking/',
		topic: 'Network',
		summary:
			'Where to place a DNS blocker, how to choose upstream resolvers, commands that prove blocking is live on each device, how to undo a rule that broke a site — and the DoH bypass that quietly exempts some clients.',
		date: 'October 2026',
		dateISO: '2026-10-19',
	},
	{
		title: 'Does Your VPN Actually Protect You? Leak Tests, Kill Switch, and DNS',
		href: '/guides/how-to-test-your-vpn/',
		topic: 'Network',
		summary:
			'A repeatable protocol: baseline, exit address, DNS, IPv6, WebRTC, a kill-switch test that does not rely on the client cooperating, and the split-tunnel rules you forgot you added.',
		date: 'October 2026',
		dateISO: '2026-10-19',
	},
	{
		title: 'External Monitor Setup on Mac and Windows: Resolution, Scaling, Refresh Rate, and Mirroring',
		href: '/guides/external-monitor-setup/',
		topic: 'Displays & docks',
		summary:
			'Extend versus mirror, native resolution against scaling, why refresh rate is negotiated rather than declared, and how cable revision, dock bandwidth and DisplayLink decide what your desk actually does.',
		date: 'October 2026',
		dateISO: '2026-10-19',
	},
	{
		title: 'Claude AI Watermarks Explained: Does Claude Watermark AI Text?',
		href: '/guides/claude-ai-watermark/',
		topic: 'AI & models',
		summary:
			'Anthropic began embedding an invisible, machine-readable watermark directly into text generated by its newest Claude models. This guide explains what the watermark is, how the mechanism works, which models and surfaces carry it, and how it differs from ChatGPT.',
		date: 'August 2026',
		dateISO: '2026-08-16',
	},
	{
		title: 'OBS Studio Complete Guide: How to Record Your Screen for Free',
		href: '/reviews/obs-studio-complete-guide/',
		topic: 'Screen recording',
		summary:
			'A step-by-step walkthrough of OBS Studio for screen recording and live streaming: what the free, open-source recorder does, the fastest route through first-time setup, the settings that produce clean recordings, and where it falls short of paid alternatives.',
		date: 'May 2026',
		dateISO: '2026-05-01',
	},
];

const siteOrigin = new URL(Astro.site).origin;

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: `${siteOrigin}/` },
		{ '@type': 'ListItem', position: 2, name: 'Guides', item: `${siteOrigin}/guides/` },
	],
};

// CollectionPage + ItemList. URLs are limited to guides that really exist.
const collectionSchema = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: 'Tool Guides & Tutorials',
	description: pageDescription,
	url: `${siteOrigin}/guides/`,
	isPartOf: { '@type': 'WebSite', name: SITE_TITLE, url: `${siteOrigin}/` },
	mainEntity: {
		'@type': 'ItemList',
		numberOfItems: guides.length,
		itemListElement: guides.map((guide, i) => ({
			'@type': 'ListItem',
			position: i + 1,
			name: guide.title,
			url: `${siteOrigin}${guide.href}`,
		})),
	},
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
		<style>
			.guides-wrap {
				box-sizing: border-box;
				width: 100%;
				max-width: 768px;
				margin: 0 auto;
				padding: 48px 24px 64px;
				min-height: calc(100vh - 200px);
			}
			.breadcrumb {
				display: flex;
				align-items: center;
				flex-wrap: wrap;
				gap: 0.3rem;
				font-size: 0.82rem;
				color: rgb(var(--gray));
				margin-bottom: 1.5rem;
			}
			.breadcrumb a {
				color: rgb(var(--gray));
				text-decoration: none;
				transition: color 0.15s ease;
			}
			.breadcrumb a:hover {
				color: var(--accent);
			}
			.breadcrumb .separator {
				color: rgb(var(--gray-light));
			}
			.breadcrumb .current {
				color: rgb(var(--gray-dark));
				font-weight: 600;
			}
			.guides-hero {
				margin-bottom: 2.5rem;
				padding-bottom: 1.5rem;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.guides-hero h1 {
				font-size: 2.2rem;
				margin: 0 0 0.75rem;
				line-height: 1.2;
			}
			.guides-hero p {
				font-size: 1.05rem;
				color: rgb(var(--gray));
				line-height: 1.7;
				margin: 0;
			}
			.guide-count {
				display: block;
				margin-top: 1rem;
				font-size: 0.78rem;
				font-weight: 600;
				letter-spacing: 0.04em;
				text-transform: uppercase;
				color: rgb(var(--gray));
			}
			.guide-list {
				display: flex;
				flex-direction: column;
				gap: 1.25rem;
			}
			.guide-card {
				display: block;
				padding: 1.5rem;
				background: var(--card-bg);
				border: 1px solid var(--card-border);
				border-radius: 12px;
				box-shadow: var(--card-shadow);
				text-decoration: none;
				transition: transform 0.15s ease, box-shadow 0.15s ease;
			}
			.guide-card:hover {
				transform: translateY(-2px);
			}
			.guide-topic {
				display: inline-block;
				font-size: 0.72rem;
				font-weight: 700;
				letter-spacing: 0.06em;
				text-transform: uppercase;
				color: var(--accent);
				margin-bottom: 0.6rem;
			}
			.guide-card h2 {
				font-size: 1.25rem;
				margin: 0 0 0.5rem;
				color: rgb(var(--gray-dark));
				line-height: 1.35;
			}
			.guide-card p {
				font-size: 0.95rem;
				line-height: 1.65;
				color: rgb(var(--gray));
				margin: 0 0 0.75rem;
			}
			.guide-card .guide-date {
				font-size: 0.8rem;
				color: rgb(var(--gray));
				text-transform: uppercase;
				letter-spacing: 0.04em;
				font-weight: 600;
			}
			.guides-note {
				margin-top: 2.5rem;
				padding-top: 1.5rem;
				border-top: 1px solid rgb(var(--gray-light));
				font-size: 0.9rem;
				line-height: 1.7;
				color: rgb(var(--gray));
			}
			.guides-note a {
				color: var(--accent);
			}
			@media (max-width: 720px) {
				.guides-wrap {
					padding: 32px 16px 48px;
				}
				.guides-hero h1 {
					font-size: 1.8rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="guides-wrap">
			<nav class="breadcrumb" aria-label="Breadcrumb">
				<a href="/">Home</a>
				<span class="separator">/</span>
				<span class="current">Guides</span>
			</nav>

			<div class="guides-hero">
				<h1>Tool Guides &amp; Tutorials</h1>
				<p>
					Step-by-step explainers from the ToolStep editorial team. Each guide documents how a
					tool, model, or standard actually works — covering the setup path, the settings and
					specifications that matter, and the limitations worth knowing before you commit.
					Everything is researched from official documentation and published specifications
					rather than marketing copy.
				</p>
				<span class="guide-count">
					{guides.length} {guides.length === 1 ? 'guide' : 'guides'} published
				</span>
			</div>

			<div class="guide-list">
				{guides.map((guide) => (
					<a class="guide-card" href={guide.href}>
						<span class="guide-topic">{guide.topic}</span>
						<h2>{guide.title}</h2>
						<p>{guide.summary}</p>
						<span class="guide-date">{guide.date}</span>
					</a>
				))}
			</div>

			<p class="guides-note">
				ToolStep guides follow the same research standards as our reviews — see
				<a href="/how-we-test/">how we evaluate products</a> and our
				<a href="/editorial-policy/">editorial policy</a>.
			</p>
		</main>
		<Footer />
	</body>
</html>
