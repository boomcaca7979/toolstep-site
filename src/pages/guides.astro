---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

const pageTitle = `Tool Guides & Tutorials — ${SITE_TITLE}`;
const pageDescription = 'In-depth, evidence-based guides from the ToolStep editorial team — how AI tools, models, and software actually work under the hood.';

// Real, published guides. Each entry mirrors the target page's own metadata.
const guides = [
	{
		title: 'Claude AI Watermark Explained: Does Claude Watermark AI Text?',
		href: '/guides/claude-ai-watermark/',
		summary:
			'Yes — new Claude models launched on or after August 2, 2026 carry an invisible text watermark wherever Claude is offered. How it works, which models are affected, the transition period, and how it compares to ChatGPT.',
		date: 'August 2026',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<style>
			.guides-wrap {
				max-width: 760px;
				margin: 0 auto;
				padding: 48px 24px 64px;
				min-height: calc(100vh - 200px);
			}
			.guides-hero h1 {
				font-size: 2.2rem;
				margin: 0 0 0.5rem;
				line-height: 1.2;
			}
			.guides-hero p {
				font-size: 1.05rem;
				color: rgb(var(--gray));
				line-height: 1.7;
				margin: 0 0 2rem;
			}
			.guide-list {
				display: flex;
				flex-direction: column;
				gap: 1.25rem;
			}
			.guide-card {
				display: block;
				padding: 1.5rem;
				background: var(--card-bg);
				border: 1px solid var(--card-border);
				border-radius: 12px;
				box-shadow: var(--card-shadow);
				text-decoration: none;
				transition: transform 0.15s ease, box-shadow 0.15s ease;
			}
			.guide-card:hover {
				transform: translateY(-2px);
			}
			.guide-card h2 {
				font-size: 1.25rem;
				margin: 0 0 0.5rem;
				color: rgb(var(--gray-dark));
				line-height: 1.35;
			}
			.guide-card p {
				font-size: 0.95rem;
				line-height: 1.65;
				color: rgb(var(--gray));
				margin: 0 0 0.75rem;
			}
			.guide-card .guide-date {
				font-size: 0.8rem;
				color: rgb(var(--gray));
				text-transform: uppercase;
				letter-spacing: 0.04em;
				font-weight: 600;
			}
			@media (max-width: 720px) {
				.guides-wrap {
					padding: 32px 16px 48px;
				}
				.guides-hero h1 {
					font-size: 1.8rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="guides-wrap">
			<div class="guides-hero">
				<h1>Tool Guides &amp; Tutorials</h1>
				<p>
					Step-by-step, evidence-based explainers from the ToolStep editorial team. Each guide
					documents how a tool, model, or standard actually works — based on official
					documentation and published specifications, not marketing copy.
				</p>
			</div>
			<div class="guide-list">
				{guides.map((guide) => (
					<a class="guide-card" href={guide.href}>
						<h2>{guide.title}</h2>
						<p>{guide.summary}</p>
						<span class="guide-date">{guide.date}</span>
					</a>
				))}
			</div>
		</main>
		<Footer />
	</body>
</html>
