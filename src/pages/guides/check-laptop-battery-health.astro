const faq = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: [
		{
			'@type': 'Question',
			name: 'What is a good battery health percentage?',
			acceptedAnswer: { '@type': 'Answer', text: 'A laptop whose full charge capacity still sits close to its design capacity — roughly 80 percent or more — is behaving normally. Lithium batteries are consumable parts, and manufacturers rate them to retain around 80 percent of capacity after a stated number of cycles, which Apple publishes per notebook model on its battery service page. Below that range, shorter runtime is expected wear, not a defect.' },
		},
		{
			'@type': 'Question',
			name: 'Does the cycle count matter more than the percentage?',
			acceptedAnswer: { '@type': 'Answer', text: 'They measure different things and both are useful. The percentage tells you how much charge the battery holds today; the cycle count tells you how much of its rated life has been consumed. A five-year-old laptop with a high cycle count but 85 percent capacity is healthier than a newer one with a sudden capacity drop, because wear that tracks cycles is predictable.' },
		},
		{
			'@type': 'Question',
			name: 'Why does my full charge capacity change between reports?',
			acceptedAnswer: { '@type': 'Answer', text: 'Full charge capacity is an estimate the battery controller calculates from recent discharge behavior, so it drifts a little between reports — small moves of a few percent are normal. What matters is the trend over months. Judge the battery on repeated readings, not on a single report, and treat a steep drop between adjacent readings as a reason to keep watching.' },
		},
		{
			'@type': 'Question',
			name: 'Can I improve my battery health once it has degraded?',
			acceptedAnswer: { '@type': 'Answer', text: 'No. Capacity loss is chemical wear inside the cells and cannot be reversed by calibration, apps, or deep discharges. What you can do is slow further wear: avoid leaving the laptop at 100 percent charge and high heat for long periods, and use the charge-limiting features built into modern Windows and macOS laptops when the machine stays plugged in most of the time.' },
		},
	],
};
