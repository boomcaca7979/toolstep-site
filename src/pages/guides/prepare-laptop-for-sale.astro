---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AdsterraBanner from '../../components/ads/AdsterraBanner.astro';

const canonicalPath = '/guides/prepare-laptop-for-sale/';
const title = 'How to Prepare Your Laptop for Sale: Wipe It Safely | ToolStep';
const description = 'A safe-sale checklist for any laptop: back up, deauthorize licenses, remove Activation Lock, sign out everywhere, and securely erase with Reset this PC or Erase All Content.';
const headline = 'How to Prepare Your Laptop for Sale: Securely Erase Mac and Windows';
const published = '2026-11-04';

const breadcrumb = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
		{ '@type': 'ListItem', position: 2, name: 'Guides', item: new URL('/guides/', Astro.site).toString() },
		{ '@type': 'ListItem', position: 3, name: headline, item: new URL(canonicalPath, Astro.site).toString() },
	],
};

const faq = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: [
		{
			'@type': 'Question',
			name: 'Is deleting my files before selling enough?',
			acceptedAnswer: { '@type': 'Answer', text: 'No. Deleting files and emptying the trash removes the pointers to the data, not the data itself, and file-recovery tools can often read it back from the drive. The only safe approach is to erase the entire volume using the operating system\u2019s reset or erase feature — Reset this PC with the clean-data option on Windows, or Erase All Content and Settings on a recent Mac.' },
		},
		{
			'@type': 'Question',
			name: 'What is Activation Lock and why does it matter so much?',
			acceptedAnswer: { '@type': 'Answer', text: 'On Apple hardware, Activation Lock ties a Mac to the iCloud account that signed in to it: after a wipe, the machine refuses to set up without that account\u2019s password. If you reset a Mac without first signing out of iCloud and disabling Find My, the buyer receives a device they cannot use — and cannot fix. Signing out before the erase is the only correct order.' },
		},
		{
			'@type': 'Question',
			name: 'Do I need special wiping software for an SSD?',
			acceptedAnswer: { '@type': 'Answer', text: 'Usually not. Modern laptops ship with SSDs, and the multi-pass overwriting tools designed for spinning hard drives are unnecessary — and on SSDs unreliable, because wear leveling means writes do not land where you think. The operating system\u2019s erase feature, which issues the drive\u2019s own secure-erase or reset command, is the supported and effective method. Verify afterwards that the device boots to a clean setup screen.' },
		},
		{
			'@type': 'Question',
			name: 'Should I sell the charger and box with the laptop?',
			acceptedAnswer: { '@type': 'Answer', text: 'Yes. A complete listing — the correct charger, the original box, and any accessories that originally shipped with it — is worth real money to buyers and signals that the machine was cared for. Note honestly in the listing that the charger is included, and run a battery health check first so you can describe the battery condition accurately.' },
		},
	],
};
