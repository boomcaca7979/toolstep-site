---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AdsterraBanner from '../../components/ads/AdsterraBanner.astro';

const canonicalPath = '/guides/recover-authenticator-app/';
const title = 'Lost Your Phone? How to Recover Your Authenticator App | ToolStep';
const description = 'Lost the phone with your 2FA codes? Recover Google Authenticator, Microsoft Authenticator, or Authy through cloud backups, transfer QRs, or saved backup codes.';
const headline = 'Lost Your Phone? How to Recover Your Authenticator App and Your 2FA Codes';
const published = '2026-11-04';

const breadcrumb = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
		{ '@type': 'ListItem', position: 2, name: 'Guides', item: new URL('/guides/', Astro.site).toString() },
		{ '@type': 'ListItem', position: 3, name: headline, item: new URL(canonicalPath, Astro.site).toString() },
	],
};

const faq = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: [
		{
			'@type': 'Question',
			name: 'Can I get my Google Authenticator codes back without the old phone?',
			acceptedAnswer: { '@type': 'Answer', text: 'Only if you previously enabled sync to your Google Account or made an export QR transfer — then the codes can be restored on a new device. Without either, the codes in the old app cannot be retrieved remotely, and each service protected by those codes must be recovered through its own account-recovery process using the backup codes issued at enrollment, if you saved them.' },
		},
		{
			'@type': 'Question',
			name: 'Are backup codes enough to regain access to an account?',
			acceptedAnswer: { '@type': 'Answer', text: 'Yes. Backup codes are generated when you first turn on two-factor authentication and are accepted at the sign-in screen in place of an authenticator code. Each code works once, so sign in with a code, remove the old device from your two-step verification settings, and enroll a new authenticator immediately.' },
		},
		{
			'@type': 'Question',
			name: 'Does Microsoft Authenticator back up my codes automatically?',
			acceptedAnswer: { '@type': 'Answer', text: 'Not by default. Cloud backup only exists after you turn it on inside the app and sign in with the Microsoft account it should be tied to. Restoring on a new phone then requires signing into that same account and completing the recovery step, and some work or school accounts restrict whether backups are permitted at all.' },
		},
		{
			'@type': 'Question',
			name: 'Should I move my 2FA codes into my password manager?',
			acceptedAnswer: { '@type': 'Answer', text: 'It is a reasonable trade-off for most people: a password manager with TOTP support fills codes automatically and backs them up encrypted. The cost is that your second factor then lives in the same vault as your passwords, so the vault becomes a single point of failure. If you keep them separate, print your backup codes and store them offline instead.' },
		},
	],
};
