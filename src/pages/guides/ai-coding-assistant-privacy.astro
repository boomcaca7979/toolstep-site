---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AdsterraBanner from '../../components/ads/AdsterraBanner.astro';

const canonicalPath = '/guides/ai-coding-assistant-privacy/';
const title = 'AI Coding Assistant Privacy: Where Does Your Code Go? | ToolStep';
const description = 'Coding assistants read your code and send it to remote servers. What gets transmitted, which controls exist per assistant, and how to decide what is safe.';
const headline = 'AI Coding Assistant Privacy: What Happens to Your Code?';
const published = '2026-11-04';

const breadcrumb = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
		{ '@type': 'ListItem', position: 2, name: 'Guides', item: new URL('/guides/', Astro.site).toString() },
		{ '@type': 'ListItem', position: 3, name: headline, item: new URL(canonicalPath, Astro.site).toString() },
	],
};

const faq = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: [
		{
			'@type': 'Question',
			name: 'What does a coding assistant actually send to its servers?',
			acceptedAnswer: { '@type': 'Answer', text: 'At minimum, your prompt plus whatever code context the product decides is relevant: the current file, related files in the workspace, open editor tabs, and sometimes repository structure or documentation. The exact scope differs by product and settings, which is why the privacy documentation of your specific assistant — not generic assumptions — is the right source.' },
		},
		{
			'@type': 'Question',
			name: 'Do coding assistants train on my code?',
			acceptedAnswer: { '@type': 'Answer', text: 'It depends on the product and the plan, and it changes over time, so check current documentation. The major assistants offer some form of training exclusion — via settings on consumer plans or via contract on business and enterprise plans — and GitHub documents Copilot\'s plan differences on its official docs. Verify the setting exists and is enabled rather than assuming either direction.' },
		},
		{
			'@type': 'Question',
			name: 'Is Cursor\'s privacy mode enough for proprietary code?',
			acceptedAnswer: { '@type': 'Answer', text: 'Privacy mode is a meaningful control — Cursor documents it in its official docs as excluding your data from training — but "not used for training" is not the same as "never stored or processed on remote servers." For proprietary code, combine privacy mode with your organization\'s review of the vendor\'s terms, retention practices, and compliance posture, or use a local model where the code never leaves the machine.' },
		},
		{
			'@type': 'Question',
			name: 'How do I stop my API keys from reaching an assistant?',
			acceptedAnswer: { '@type': 'Answer', text: 'Keep secrets out of the files an assistant indexes: store them in environment variables or a secrets manager, never hard-coded in source. Before enabling a new assistant on an existing repo, scan for leaked credentials, rotate anything that has ever been committed, and treat .env files as unsharable. If a key was sent upstream, rotation is the only real fix.' },
		},
	],
};
---

