---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AdsterraBanner from '../../components/ads/AdsterraBanner.astro';

const canonicalPath = '/guides/how-to-verify-a-download/';
const title = 'How to Verify a Download Before You Install It: Checksums and Signatures | ToolStep';
const description = 'Use certutil, Get-FileHash, shasum, sha256sum and GPG to confirm a downloaded file is intact and really came from the publisher — and understand what that check does not prove.';
const headline = 'How to Verify a Download Before You Install It: Checksums and Signatures';
const published = '2026-10-19';

const breadcrumb = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
		{ '@type': 'ListItem', position: 2, name: 'Guides', item: new URL('/guides/', Astro.site).toString() },
		{ '@type': 'ListItem', position: 3, name: headline, item: new URL(canonicalPath, Astro.site).toString() },
	],
};

const faq = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: [
		{
			'@type': 'Question',
			name: "If the checksum matches, is the file safe to run?",
			acceptedAnswer: { '@type': 'Answer', text: "No. A matching checksum means the file is identical to what the publisher hashed and arrived intact. It cannot tell you the file is free of malicious code, and it passes even if an attacker replaced both the file and the published value." },
		},
		{
			'@type': 'Question',
			name: "Why is the hash published on the same website I downloaded from?",
			acceptedAnswer: { '@type': 'Answer', text: "Often that is what a project can offer, and it still catches corruption and mirror tampering. It does not defend against an attacker who controls the site. When both a checksum and a detached signature exist, the signature checked against a separately obtained key is the stronger control." },
		},
		{
			'@type': 'Question',
			name: "Do I need to verify files from an app store or package manager?",
			acceptedAnswer: { '@type': 'Answer', text: "Not manually. Stores and package managers such as apt or dnf already validate integrity and origin during installation. This guide is for loose downloads: direct installer links, mirrors, firmware files, and model weights." },
		},
		{
			'@type': 'Question',
			name: "Is SHA-256 the right algorithm?",
			acceptedAnswer: { '@type': 'Answer', text: "Match whatever the publisher posted, and prefer SHA-256 when you choose. MD5 and SHA-1 still reveal a corrupted transfer, but they are not appropriate where you need to rule out intentional substitution." },
		},
	],
};
