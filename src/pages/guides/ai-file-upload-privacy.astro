---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AdsterraBanner from '../../components/ads/AdsterraBanner.astro';

const canonicalPath = '/guides/ai-file-upload-privacy/';
const title = 'Before Uploading Files to AI: A Privacy Checklist | ToolStep';
const description = 'Uploading a file to an AI chatbot sends its contents to vendor servers. A checklist for classifying files, checking provider data controls, and redacting first.';
const headline = 'Before Uploading Files to AI: A Privacy and Security Checklist';
const published = '2026-11-04';

const breadcrumb = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
		{ '@type': 'ListItem', position: 2, name: 'Guides', item: new URL('/guides/', Astro.site).toString() },
		{ '@type': 'ListItem', position: 3, name: headline, item: new URL(canonicalPath, Astro.site).toString() },
	],
};

const faq = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: [
		{
			'@type': 'Question',
			name: 'What actually happens when I upload a file to an AI chatbot?',
			acceptedAnswer: { '@type': 'Answer', text: 'The file is copied from your device to the provider\'s servers, where software extracts its text and structure so the model can process it. Your conversation and its attachments may be stored for some period, and depending on your account tier and settings, that content may be reviewed by humans or used to train future models. The exact behavior depends on the provider and your settings, so check the data controls before uploading anything sensitive.' },
		},
		{
			'@type': 'Question',
			name: 'How can I stop a provider from using my chats for training?',
			acceptedAnswer: { '@type': 'Answer', text: 'All major consumer providers offer some form of data control: OpenAI\'s settings at help.openai.com, Google\'s activity controls at support.google.com, and Anthropic\'s privacy settings each include training opt-outs and history controls. Open your account\'s data settings page and look for the training-use and chat-history toggles before relying on the tool for anything personal.' },
		},
		{
			'@type': 'Question',
			name: 'Is a paid plan automatically more private?',
			acceptedAnswer: { '@type': 'Answer', text: 'Not automatically, though enterprise and team agreements typically include stronger commitments, such as contractual exclusions from training use, that consumer terms do not. The word "typically" matters: the specifics live in each plan\'s terms and admin settings. Verify what your plan and your organization\'s configuration actually say rather than assuming the tier upgrades privacy on its own.' },
		},
		{
			'@type': 'Question',
			name: 'What should I never upload to a consumer AI chatbot?',
			acceptedAnswer: { '@type': 'Answer', text: 'As a baseline: other people\'s personal data you have no right to share, client files covered by confidentiality agreements, credentials and API keys, and medical or financial records you would not want stored on a third-party server. If the file genuinely needs AI analysis but contains those items, redact them first or use a local model that never leaves your device.' },
		},
	],
};
