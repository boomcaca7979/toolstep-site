---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AdsterraBanner from '../../components/ads/AdsterraBanner.astro';

const canonicalPath = '/guides/password-manager-migration/';
const title = 'How to Move Your Password Vault to a New Manager Without Losing Accounts | ToolStep';
const description = 'A safe order of operations for migrating a password vault: what exports actually carry, handling plaintext CSV, re-enrolling 2FA, verifying shared collections, and rolling back cleanly.';
const headline = 'How to Move Your Password Vault to a New Manager Without Losing Accounts';
const published = '2026-10-18';

const breadcrumb = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
		{ '@type': 'ListItem', position: 2, name: 'Guides', item: new URL('/guides/', Astro.site).toString() },
		{ '@type': 'ListItem', position: 3, name: headline, item: new URL(canonicalPath, Astro.site).toString() },
	],
};

const faq = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: [
		{
			'@type': 'Question',
			name: "Will my two-factor authenticator codes move with the vault?",
			acceptedAnswer: { '@type': 'Answer', text: "Do not count on it. Plain CSV usually carries only login fields, and even a richer export is not guaranteed to produce working codes in a different product. Re-enrol each protected site, keeping the old authenticator live until the new one matches." },
		},
		{
			'@type': 'Question',
			name: "How long should I keep the old account active?",
			acceptedAnswer: { '@type': 'Answer', text: "Two to four weeks of everyday use plus one deliberate check of awkward items — shared logins, a monthly VPN, rarely-visited portals. Cancel only after those work, and export from the new manager before the old plan lapses." },
		},
		{
			'@type': 'Question',
			name: "Is a password-protected export safe to email or upload?",
			acceptedAnswer: { '@type': 'Answer', text: "Treat any export as sensitive. Protected exports are only as strong as the password on them and the channel you send them through, and some encrypted formats cannot be opened by any other account. Copy locally, delete everywhere afterwards." },
		},
		{
			'@type': 'Question',
			name: "Does moving vaults move my passkeys too?",
			acceptedAnswer: { '@type': 'Answer', text: "Usually not. Passkeys are held per provider and per device, so plan to create them again in the new place, and keep a fallback sign-in method working before you remove anything." },
		},
	],
};
---

<html lang="en">
<head>
  <BaseHead title={title} description={description} ogType="article" articleSchema={{ headline, description, datePublished: published, dateModified: published, authorName: 'ToolStep Editorial Team' }} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
  <script type="application/ld+json" set:html={JSON.stringify(faq)} />
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 1.05rem; line-height: 1.7; color: #374151; background: #fff; }
    .container { max-width: 800px; margin: 0 auto; padding: 40px 24px; }
    .article-header { text-align: center; margin-bottom: 32px; }
    .tag { display: inline-block; background: #f3f4f6; color: #374151; padding: 6px 16px; border-radius: 20px; font-size: 0.85rem; font-weight: 600; margin-bottom: 12px; text-decoration: none; }
    .tag:hover { background: #e5e7eb; }
    h1 { font-size: 2.25rem; font-weight: 800; color: #111; line-height: 1.2; margin-bottom: 8px; }
    .meta { color: #6b7280; font-size: 0.9rem; }
    .lead { font-size: 1.15rem; color: #4b5563; margin-bottom: 24px; padding-bottom: 24px; border-bottom: 1px solid #e5e7eb; }
    h2 { font-size: 1.5rem; font-weight: 700; color: #111; margin-top: 40px; margin-bottom: 16px; }
    h3 { font-size: 1.15rem; font-weight: 600; color: #111; margin-top: 24px; margin-bottom: 8px; }
