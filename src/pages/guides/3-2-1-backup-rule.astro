---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AdsterraBanner from '../../components/ads/AdsterraBanner.astro';

const canonicalPath = '/guides/3-2-1-backup-rule/';
const title = 'The 3-2-1 Backup Rule, Applied to a Real Home-Office Computer | ToolStep';
const description = 'What 3-2-1 means in practice on one Mac or PC: which copies to make, how to automate them, why sync is not backup, and how to run a restore drill that proves it works.';
const headline = 'The 3-2-1 Backup Rule, Applied to a Real Home-Office Computer';
const published = '2026-10-19';

const breadcrumb = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
		{ '@type': 'ListItem', position: 2, name: 'Guides', item: new URL('/guides/', Astro.site).toString() },
		{ '@type': 'ListItem', position: 3, name: headline, item: new URL(canonicalPath, Astro.site).toString() },
	],
};

const faq = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: [
		{
			'@type': 'Question',
			name: "Is cloud sync the same as a backup?",
			acceptedAnswer: { '@type': 'Answer', text: "No. Sync keeps locations matching, so deletions, bad saves, and encrypted files spread to everywhere that is connected. Version history helps, but a rolling window is not an archive and an account lockout reaches both." },
		},
		{
			'@type': 'Question',
			name: "Does a second computer in the same house count as a different medium?",
			acceptedAnswer: { '@type': 'Answer', text: "Only weakly. Same power supply, same flood zone, same theft, often the same shared storage. A drive in another building, or a separate cloud account, is a genuinely different risk pool." },
		},
		{
			'@type': 'Question',
			name: "How often should I test a restore?",
			acceptedAnswer: { '@type': 'Answer', text: "Quarterly is a sensible default, and any cadence beats none. Test one file from last month, one whole folder restored somewhere new, and one pull specifically from the off-site copy." },
		},
		{
			'@type': 'Question',
			name: "What about data that only exists in a web app?",
			acceptedAnswer: { '@type': 'Answer', text: "It needs an export plan, because your disk backup never sees it. Schedule exports of mail, contacts, notes, and cloud-only documents into a folder that your Time Machine or File History destination actually covers." },
		},
	],
};
---

<html lang="en">
<head>
  <BaseHead title={title} description={description} ogType="article" articleSchema={{ headline, description, datePublished: published, dateModified: published, authorName: 'ToolStep Editorial Team' }} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
  <script type="application/ld+json" set:html={JSON.stringify(faq)} />
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 1.05rem; line-height: 1.7; color: #374151; background: #fff; }
    .container { max-width: 800px; margin: 0 auto; padding: 40px 24px; }
    .article-header { text-align: center; margin-bottom: 32px; }
    .tag { display: inline-block; background: #f3f4f6; color: #374151; padding: 6px 16px; border-radius: 20px; font-size: 0.85rem; font-weight: 600; margin-bottom: 12px; text-decoration: none; }
    .tag:hover { background: #e5e7eb; }
    h1 { font-size: 2.25rem; font-weight: 800; color: #111; line-height: 1.2; margin-bottom: 8px; }
    .meta { color: #6b7280; font-size: 0.9rem; }
