---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AdsterraBanner from '../../components/ads/AdsterraBanner.astro';

const canonicalPath = '/guides/microphone-level-setup/';
const title = 'Why Your Microphone Sounds Too Quiet: Gain, Input Levels, and OS Limits | ToolStep';
const description = 'A four-stage troubleshooting flow for a quiet microphone: physical path, OS input volume and gain, app processing, then distance and polar pattern. What gain, input level and clipping actually mean.';
const headline = 'Why Your Microphone Sounds Too Quiet: Gain, Input Levels, and OS Limits';
const published = '2026-10-18';

const breadcrumb = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
		{ '@type': 'ListItem', position: 2, name: 'Guides', item: new URL('/guides/', Astro.site).toString() },
		{ '@type': 'ListItem', position: 3, name: headline, item: new URL(canonicalPath, Astro.site).toString() },
	],
};

const faq = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: [
		{
			'@type': 'Question',
			name: "What input level should my microphone be set to?",
			acceptedAnswer: { '@type': 'Answer', text: "There is no single correct number that applies to every microphone, room, and app. The goal is relative: your voice moves the meter clearly and consistently at normal speech, peaks do not sit flat against the top, and the setting still sounds right when you lean back or talk louder." },
		},
		{
			'@type': 'Question',
			name: "Why does my microphone volume slider look greyed out or missing?",
			acceptedAnswer: { '@type': 'Answer', text: "Some devices do not expose input gain to the operating system, so the control is shown disabled or omitted entirely. Set the level with a dial or pad switch on the microphone, on the interface, in the device driver panel, or with the input volume inside your app." },
		},
		{
			'@type': 'Question',
			name: "Is distorted microphone audio always caused by gain being too high?",
			acceptedAnswer: { '@type': 'Answer', text: "Usually, but the overdriven stage may be the capsule because the source is too close, the interface gain, the OS input volume, or software effects applied afterwards. Change one control at a time and listen for the point where the harshness goes away." },
		},
		{
			'@type': 'Question',
			name: "Should I turn off automatic gain control?",
			acceptedAnswer: { '@type': 'Answer', text: "Turn it off while diagnosing, then decide. It hides the real level by pushing quiet voices up and loud ones down. Measure with it disabled to confirm your hardware is genuinely healthy; many people leave it on for calls and off for recording." },
		},
	],
};
