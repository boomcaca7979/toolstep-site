---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AdsterraBanner from '../../components/ads/AdsterraBanner.astro';

const canonicalPath = '/guides/passkeys-explained/';
const title = 'Passkeys Explained: How They Work, What They Protect, and How Not to Get Locked Out | ToolStep';
const description = 'What a passkey is, how WebAuthn public-key sign-in works, the difference between synced and device-bound passkeys, and the recovery steps that keep you out of your own account.';
const headline = 'Passkeys Explained: How They Work, What They Protect, and How Not to Get Locked Out';
const published = '2026-10-18';

const breadcrumb = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
		{ '@type': 'ListItem', position: 2, name: 'Guides', item: new URL('/guides/', Astro.site).toString() },
		{ '@type': 'ListItem', position: 3, name: headline, item: new URL(canonicalPath, Astro.site).toString() },
	],
};

const faq = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: [
		{
			'@type': 'Question',
			name: "Are passkeys the same as two-factor authentication?",
			acceptedAnswer: { '@type': 'Answer', text: "No. A passkey is a complete credential, not a second factor bolted onto a password. It proves identity with a signature from a private key that stays on your side, so there is usually no password step and no code step. Many accounts still list both methods side by side." },
		},
		{
			'@type': 'Question',
			name: "Can a passkey be stolen or reused on another website?",
			acceptedAnswer: { '@type': 'Answer', text: "It cannot be replayed on a lookalike domain because the credential is scoped to the origin it was made for. What can go wrong is losing access to wherever the private key lives — an unlockable device, or a sync account that gets locked or recovered by someone else." },
		},
		{
			'@type': 'Question',
			name: "What happens if I lose the device holding my passkey?",
			acceptedAnswer: { '@type': 'Answer', text: "Synced passkeys are available from another device on the same provider account, and you can revoke the old credential from account security settings. Device-bound passkeys, such as those on a security key, are simply gone until you re-enrol. That distinction decides how bad the loss is." },
		},
		{
			'@type': 'Question',
			name: "Should I delete my passwords after creating a passkey?",
			acceptedAnswer: { '@type': 'Answer', text: "Not right away. Support varies by site and browser, older hardware may not complete a passkey prompt, and losing the provider account password would take your synced passkeys with it. Keep a fallback until you have signed in successfully on more than one device." },
		},
	],
};
---

<html lang="en">
<head>
