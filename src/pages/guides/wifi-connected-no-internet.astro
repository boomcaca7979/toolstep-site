const canonicalPath = '/guides/wifi-connected-no-internet/';
const title = 'Wi-Fi Connected but No Internet? How to Fix It (Windows, Mac, Router) | ToolStep';
const description = 'A layer-by-layer fix for the "connected, no internet" error: identify whether the problem is one device, the router, or your ISP, then renew DHCP, repair DNS, and reset the network stack with exact commands.';
const headline = 'Wi-Fi Connected but No Internet? A Layer-by-Layer Fix for Windows, Mac, and Your Router';
const published = '2026-11-04';

const breadcrumb = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
		{ '@type': 'ListItem', position: 2, name: 'Guides', item: new URL('/guides/', Astro.site).toString() },
		{ '@type': 'ListItem', position: 3, name: headline, item: new URL(canonicalPath, Astro.site).toString() },
	],
};

const faq = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: [
		{
			'@type': 'Question',
			name: 'What does "connected, no internet" actually mean?',
			acceptedAnswer: { '@type': 'Answer', text: 'Your device successfully joined the Wi-Fi network, which only proves a radio link to the router. It says nothing about whether the router has a working line to your internet provider, whether your device received a valid IP address, or whether DNS is resolving. The error can originate at any of those three layers.' },
		},
		{
			'@type': 'Question',
			name: 'Why does my phone say no internet but my laptop works?',
			acceptedAnswer: { '@type': 'Answer', text: 'When one device works, the router and the ISP line are fine, so the fault is local to the failing device: a stale DHCP lease, a cached bad DNS answer, a VPN or proxy that is still routing traffic somewhere dead, or a corrupted network profile. Fix that device first before touching the router.' },
		},
		{
			'@type': 'Question',
			name: 'Should I change my DNS server to fix this?',
			acceptedAnswer: { '@type': 'Answer', text: 'Only if the diagnosis points at DNS. A quick test is to open a raw IP address such as https://1.1.1.1 in a browser: if that loads but names do not resolve, DNS is the problem and switching to a public resolver helps. If the raw IP also fails, DNS is not the issue and you should repair the IP configuration instead.' },
		},
		{
			'@type': 'Question',
			name: 'How do I know if the problem is my internet provider?',
			acceptedAnswer: { '@type': 'Answer', text: 'Check whether every device on the network is offline and look at the router status page or the WAN/Internet indicator light. If the router shows no WAN address or the light is red or off after a full reboot, contact your provider. Your account status page and the provider outage map are also worth checking from a mobile connection.' },
		},
	],
};
