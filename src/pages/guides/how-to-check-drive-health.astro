const canonicalPath = '/guides/how-to-check-drive-health/';
const title = 'How to Check Whether a Drive Is Failing — and What to Do in the Hours You Have Left | ToolStep';
const description = 'What SMART attributes and SSD wear counters really tell you, the failure signals they miss, and the order to act in when a drive starts dropping out or throwing read errors.';
const headline = 'How to Check Whether a Drive Is Failing — and What to Do in the Hours You Have Left';
const published = '2026-10-19';

const breadcrumb = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
		{ '@type': 'ListItem', position: 2, name: 'Guides', item: new URL('/guides/', Astro.site).toString() },
		{ '@type': 'ListItem', position: 3, name: headline, item: new URL(canonicalPath, Astro.site).toString() },
	],
};

const faq = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: [
		{
			'@type': 'Question',
			name: "My drive reports SMART status as OK. Is it safe?",
			acceptedAnswer: { '@type': 'Answer', text: "Only un-flagged. A pass means no vendor threshold has been crossed at that moment. Drives do fail without prior SMART warning, especially from electronic or firmware faults, and some attributes never arrive through USB enclosures. Keep backups regardless of the report." },
		},
		{
			'@type': 'Question',
			name: "Should I run a disk repair tool if I suspect failure?",
			acceptedAnswer: { '@type': 'Answer', text: "After the copy, not before. Repair, extended self-tests, defragmentation, scrubs, and benchmarks are sustained workloads on a device you already distrust." },
		},
		{
			'@type': 'Question',
			name: "How many reallocated sectors mean the drive is dying?",
			acceptedAnswer: { '@type': 'Answer', text: "There is no universal number, because thresholds are manufacturer- and model-specific. Trend plus symptoms is the defensible test: a climbing count with read errors or dropouts is enough reason to stop trusting the drive with the only copy of anything." },
		},
		{
			'@type': 'Question',
			name: "Do SSDs warn before they fail?",
			acceptedAnswer: { '@type': 'Answer', text: "Sometimes — through wear, available-spare, media and integrity error counters, and unsafe shutdown counts. But they can also stop responding with no advance signal, so wear figures are planning information, not an alarm." },
		},
	],
};
