const description = 'Compare exFAT, NTFS, and APFS: cross-platform compatibility, file and volume size limits, journaling, encryption, and a use-case table for picking the right format for any drive.';
const headline = 'exFAT vs NTFS vs APFS: Which File System to Choose, With a Compatibility Matrix';
const published = '2026-11-04';

const breadcrumb = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
		{ '@type': 'ListItem', position: 2, name: 'Guides', item: new URL('/guides/', Astro.site).toString() },
