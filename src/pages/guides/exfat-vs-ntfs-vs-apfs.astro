	],
};

const faq = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: [
		{
			'@type': 'Question',
			name: 'Can macOS write to NTFS drives?',
			acceptedAnswer: { '@type': 'Answer', text: 'By default, no. macOS can read NTFS volumes but mounts them read-only, so you cannot copy files onto the drive without third-party driver software. For a drive that moves between a Mac and a Windows PC, format it as exFAT instead, because both operating systems read and write exFAT natively.' },
		},
		{
			'@type': 'Question',
			name: 'Is exFAT less reliable than NTFS?',
			acceptedAnswer: { '@type': 'Answer', text: 'exFAT is a simpler file system without a journal, so an unexpected power loss or unplugged cable is more likely to leave corruption that a repair tool must fix. That trade-off is acceptable for a removable drive used to move files around, but for an internal system or backup drive on Windows use NTFS, and on a Mac use APFS.' },
		},
		{
			'@type': 'Question',
			name: 'Should I still use FAT32?',
			acceptedAnswer: { '@type': 'Answer', text: 'Rarely. FAT32 cannot store a single file larger than 4 GB and limits volumes to 32 GB when formatted from Windows tools, which makes it a poor choice for modern drives. Keep it only for devices whose firmware explicitly requires FAT32, such as some cameras, game consoles, car stereos, and embedded devices. exFAT exists precisely to replace it.' },
		},
		{
			'@type': 'Question',
			name: 'Does formatting a drive erase all data permanently?',
			acceptedAnswer: { '@type': 'Answer', text: 'A standard format rebuilds the file system structures and makes the old files inaccessible to the operating system, but the data blocks may remain until overwritten. If you are passing the drive to someone else, back up first and then erase it using a secure erase option where the operating system offers one, rather than relying on a plain quick format.' },
		},
	],
};
