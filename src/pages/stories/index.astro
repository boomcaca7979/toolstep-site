---
import PageLayout from '../../components/PageLayout.astro';
import { storiesData } from '../../data/stories';

const pageTitle = 'Web Stories — ToolStep Visual Stories';
const pageDescription = `${storiesData.length} web stories covering hardware reviews, software comparisons, and productivity guides — concise, text-first breakdowns of the tools we test.`;
const lastUpdated = 'June 2026';

const fmtDate = (iso) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  });

// Group by category preserving order
const categories: { name: string; color: string; items: typeof storiesData }[] = [];
for (const story of storiesData) {
  let group = categories.find(c => c.name === story.category);
  if (!group) {
    group = { name: story.category, color: story.color, items: [] };
    categories.push(group);
  }
  group.items.push(story);
}
---

<PageLayout
  title="ToolStep Web Stories: Software & AI Tool Guides — ToolStep"
  description={pageDescription}
  subtitle={`${storiesData.length} stories — clear, text-first breakdowns of our top picks, comparisons, and buying guides.`}
  lastUpdated={lastUpdated}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Stories' },
  ]}
>
  <div class="stories-categories">
    {categories.map((cat) => (
      <section class="category-section">
        <h2>
          <span class="category-dot" style={`background: ${cat.color}`}></span>
          {cat.name}
          <span class="category-count">{cat.items.length}</span>
        </h2>
        <div class="stories-grid">
          {cat.items.map((story) => (
            <a href={`/stories/${story.slug}/`} class="story-card" style={`--accent: ${story.color}`}>
              <div class="story-eyebrow">
                <span class="eyebrow-dot" aria-hidden="true"></span>
                <span class="eyebrow-cat">{story.category}</span>
                <time class="eyebrow-date" datetime={story.datePublished}>{fmtDate(story.datePublished)}</time>
              </div>
              <h3 class="story-title">{story.title}</h3>
              <p class="story-desc">{story.description}</p>
              <span class="story-read">Read the story <span aria-hidden="true">→</span></span>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</PageLayout>

<style>
  .stories-categories {
    margin: 1rem 0;
  }
  .category-section {
    margin-bottom: 2.5rem;
  }
  .category-section h2 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.5rem;
    margin: 0 0 1rem;
    color: rgb(var(--black));
  }
  .category-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .category-count {
    font-size: 0.8rem;
    font-weight: 600;
    color: rgb(var(--gray));
    background: rgba(var(--gray-light), 60%);
    padding: 2px 10px;
    border-radius: 12px;
    margin-left: 0.25rem;
  }
  .stories-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
    gap: 1rem;
  }
  .story-card {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 1.05rem 1.15rem 1rem;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 12px;
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }
  .story-card:hover {
    transform: translateY(-3px);
    border-color: rgb(var(--gray));
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.07);
  }
  .story-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .eyebrow-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    flex-shrink: 0;
    background: var(--accent);
  }
  .eyebrow-cat {
    color: rgb(var(--gray-dark));
  }
  .eyebrow-date {
    margin-left: auto;
    font-weight: 500;
    text-transform: none;
    letter-spacing: 0;
    color: rgb(var(--gray));
  }
  .story-title {
    font-size: 1.02rem;
    font-weight: 700;
    color: rgb(var(--black));
    line-height: 1.32;
    margin: 0.1rem 0 0;
  }
  .story-desc {
    font-size: 0.85rem;
    color: rgb(var(--gray));
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .story-read {
    margin-top: auto;
    padding-top: 0.35rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--accent);
  }
  @media (max-width: 720px) {
    .stories-grid {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
  }
</style>
